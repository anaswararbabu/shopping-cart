<section>
    <div class="container">
        <div class="row mt-4">
            <a href="/admin/add-product" class="btn btn-success ml-auto" >Add Product</a>
        </div>
        <table class="table table-bordered mt-3" id="productsTable">
  <thead class="thead-dark">
    <tr>
      <th scope="col">No</th>
      <th scope="col">Title</th>
      <th scope="col">Category</th>
      <th scope="col">Price</th>
      <th scope="col">Description</th>
      <th scope="col">Image</th>
      <th scope="col">Options</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">{{inc @index}}</th>
      <td>{{this.Name}}</td>
      <td>{{this.Category}}</td>
      <td>{{this.Price}}</td>
      <td>{{shorten this.Description 50}}</td>
      <!--<td><img style="width: 50px;height:50px" src="/images/product-images/{{this._id}}.jpeg"></td>-->
       <td><img style="width: 50px;height:50px" src="{{this.image}}"></td>
     
      <td>
        <a href="/admin/edit-product/{{this._id}}" class="btn btn-primary">Update</a>
        <a href="/admin/delete-product/{{this._id}}" class="btn btn-danger" onclick="return confirm('Are you want to delete {{this.Name}} ?')">Delete</a>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
    </div>
</section>

<script>
  $(function(){
    $('#productsTable').DataTable();
  })
</script>