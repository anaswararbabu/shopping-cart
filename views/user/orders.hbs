<section>
    <div class="container">
        <table class="table table-bordered table-hover mt-5" id="orderTable">
            <thead class="thead-dark">
            <tr>
                <th>Date</th>
                <th>Address</th>
                <th>Pincode</th>
                <th>Mobile</th>
                <th>Amount</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
                {{#each orders}}
                <tr>
                <td>{{this.date}}</td>
                <td>{{this.deliveryDetails.address}}</td>
                <td>{{this.deliveryDetails.pincode}}</td>
                <td>{{this.deliveryDetails.mobile}}</td>
                <td>{{this.totalAmount}}</td>
                <td>{{this.paymentMethod}}</td>
                <td>
                    {{#if (eq this.status "placed")}} 
                    <span class="badge bg-warning text-dark">Placed</span>
                    {{/if}}
                     {{#if (eq this.status "pending")}} 
                    <span class="badge bg-secondary">Pending</span>
                    {{/if}}
                     {{#if (eq this.status "Shipped")}} 
                    <span class="badge bg-info ">Shipped</span>
                    {{/if}}
                     {{#if (eq this.status "Delivered")}} 
                    <span class="badge bg-success">Delivered</span>
                    {{/if}}
                     {{#if (eq this.status "cancelled")}} 
                    <span class="badge bg-danger ">Cancelled</span>
                    {{/if}}
                </td>
                <td>
                    <a href="/view-order-products/{{this._id}}" class="btn btn-primary">View Products</a>
                </td>
            </tr>
            {{/each}}
            </tbody>
        </table>
    </div>
</section>
<script>
     function cancelOrder(orderId){
        if(confirm("Are you sure want to cancel this order?")){
            $.ajax({
                url:'/cancel-order/'+orderId,
                method:'post',
                success:(response)=>{
                    console.log(response)
                    if(response.status){
                        alert("Order Cancelled Successfully")
                        location.reload()
                    }
                }
            })
        }
    }
     $(function(){
    $('#orderTable').DataTable();
  })
</script>