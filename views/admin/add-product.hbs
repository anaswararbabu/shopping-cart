<section>
  <div class="container">
    <div class="row justify-content-center mt-4">

      <div class="col-md-6 col-lg-5">
        <h2 class="text-center mb-4">Add Product</h2>

        <form action="/admin/add-product" method="post" enctype="multipart/form-data">

          <label>Name</label>
          <input type="text" name="Name" class="form-control mb-3">

          <label>Category</label>
          <input type="text" name="Category" class="form-control mb-3">

          <label>Price</label>
          <input type="text" name="Price" class="form-control mb-3">

          <label>Description</label>
          <input type="text" name="Description" class="form-control mb-3">

          <label>Image</label>
          <input type="file" name="Image" class="form-control mb-4">

          <button type="submit" class="btn btn-success w-100">Submit</button>

        </form>
      </div>

    </div>
  </div>
</section>
    